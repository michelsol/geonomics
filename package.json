{
  "name": "geotrade",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @geotrade/web dev",
    "build": "pnpm --filter @geotrade/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "headless": "pnpm --filter @geotrade/headless start",
    "e2e": "pnpm --filter @geotrade/web e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
